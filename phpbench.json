{
    "runner.bootstrap": "benchmarks/bootstrap.php",
    "runner.path": "benchmarks",
    "runner.file_pattern": "*Bench.php",
    "runner.php_config": {
        "memory_limit": "1G",
        "error_reporting": 8191
    },
    "runner.time_unit": "milliseconds",
    "report.generators": {
        "results": {
            "generator": "expression",
            "cols": ["benchmark", "subject", "set", "revs", "its", "mode", "rstdev", "mem_peak"]
        }
    }
}
