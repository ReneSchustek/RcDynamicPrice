            "min": 1,
            "mode": "max_rest",
            "expected": [
                5000,
                3000
            ]
        },
        {
            "name": "max_rest_no_remainder",
            "total": 10000,
            "maxPiece": 5000,
            "min": 1,
            "mode": "max_rest",
            "expected": [
                5000,
                5000
            ]
        },
        {
            "name": "max_rest_remainder_below_min",
            "total": 6000,
            "maxPiece": 5000,
            "min": 2000,
            "mode": "max_rest",
            "expected": [
                5000,
                1000
            ],
            "comment": "Rest 1000 liegt unter min 2000: geschnitten wird 1000, berechnet die Mindestlänge (im Processor)."
        },
        {
            "name": "max_rest_three_full_plus_remainder",
            "total": 17000,
            "maxPiece": 5000,
            "min": 1,
            "mode": "max_rest",
            "expected": [
                5000,
