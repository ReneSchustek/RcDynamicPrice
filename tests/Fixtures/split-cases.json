            "min": 0,
            "mode": "max_rest",
            "expected": [
                5000,
                1000
            ]
        },
        {
            "name": "max_piece_zero_no_split",
            "total": 8000,
            "maxPiece": 0,
            "min": 1,
            "mode": "equal",
            "expected": [
                8000
            ]
        },
        {
            "name": "hint_mode_no_split",
