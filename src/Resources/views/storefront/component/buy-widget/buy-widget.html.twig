{% sw_extends '@Storefront/storefront/component/buy-widget/buy-widget.html.twig' %}

{# Die Länge steht oben: direkt hinter den Varianten, vor den Eingabefeldern von
   TmmsProductCustomerInputs. Der Block gehört TMMS; die Erweiterung erbt von TMMS, weil sie einen höheren
   Vorrang beim Laden der Vorlagen hat (`RcDynamicPrice::getTemplatePriority()`). Fehlt TMMS,
   gibt es den Block nicht, und das Feld bleibt im Kaufformular (buy-widget-form.html.twig). #}
{% block buy_widget_configurator_include_customerinput %}
    {% if page.extensions.rcDynamicPriceConfig is defined and page.product.extensions.tmmsCustomerInputCountValue is defined %}
        <div class="rc-dynamic-price-above-inputs row g-2">
            {% sw_include '@RcDynamicPrice/storefront/component/buy-widget/rc-dynamic-price-field.html.twig' with {
                product: page.product,
                rcConfig: page.extensions.rcDynamicPriceConfig,
                rcFormId: 'productDetailPageBuyProductForm'
            } %}
        </div>
    {% endif %}

    {# Längenschalter mit weiteren Variantengruppen: Die Längeneingabe gehört direkt unter die
       Längengruppe, nicht hinter „Ausführung“. Im Quelltext geht das nicht, die Variantenauswahl ist ein
       eigenes Formular, und ein Formular darf in keinem anderen stehen. Die Markierung ordnet die Kaufbox
       deshalb nur in der Darstellung (base.scss, `.rc-length-order`); sie trägt die Nummer des Längenfelds.
       Mit Meterpreis steht schon dessen Feld oben, bei „Größen nur über die Länge“ gibt es keine Knöpfe. #}
    {% set rcLength = page.extensions.rcLengthSettings|default(null) %}
    {% if rcLength and rcLength.lengthSwitch and rcLength.lengthGroupId and not rcLength.lengthOnly and page.extensions.rcDynamicPriceConfig is not defined %}
        <span class="rc-length-order rc-length-order--field-{{ rcLength.lengthFieldNumber }}" hidden></span>
    {% endif %}

    {{ parent() }}
{% endblock %}

{# Geführte Auswahl: Bis die Variante feststeht, sind Preis und Kaufknopf verborgen (base.scss,
   `.rc-guided-incomplete`). Damit der Kunde trotzdem weiß, wo der Artikel preislich liegt, steht über der Auswahl
   der Preis der günstigsten, also meist der kleinsten Variante als „ab …". Steht die Variante fest, tritt der
   richtige Preis an seine Stelle. #}
{% block buy_widget_configurator_include %}
    {% set rcFromPrice = page.extensions.rcGuidedSelection is defined ? (page.product.calculatedCheapestPrice ?? null) : null %}
    {% if rcFromPrice %}
        <p class="rc-guided-from-price">
            {{ 'listing.listingTextFrom'|trans|sw_sanitize }}
            <strong>{{ rcFromPrice.unitPrice|currency }}</strong>{{ 'general.star'|trans|sw_sanitize }}
        </p>
    {% endif %}
    {{ parent() }}
{% endblock %}
