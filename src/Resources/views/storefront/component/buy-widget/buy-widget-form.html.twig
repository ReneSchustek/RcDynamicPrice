{% sw_extends '@Storefront/storefront/component/buy-widget/buy-widget-form.html.twig' %}

{% block buy_widget_buy_quantity_container %}
    {# Die Angaben setzt `ProductPageSubscriber` nur bei eingeschaltetem Meterpreis; weitere Prüfungen der
       Zusatzfelder braucht es hier nicht. #}
    {% if page.extensions.rcDynamicPriceConfig is defined %}
        {% set rcConfig = page.extensions.rcDynamicPriceConfig %}
        {# Mit TmmsProductCustomerInputs steht das Feld über deren Eingabefeldern, direkt hinter den
           Varianten (siehe buy-widget.html.twig): Die Länge kommt vor Gehrung, Farbe und allen anderen
           Angaben. Ohne TMMS bleibt es hier im Kaufformular. #}
        {% if page.product.extensions.tmmsCustomerInputCountValue is not defined %}
            {% sw_include '@RcDynamicPrice/storefront/component/buy-widget/rc-dynamic-price-field.html.twig' with {
                product: product,
                rcConfig: rcConfig
            } %}
        {% endif %}

        {# Statt des Mengenwählers: Ein Zuschnitt ist eine Position, die Länge bestimmt den Preis.

           `data-dynamic-price` bleibt am Kaufformular, auch wenn das Feld davor steht: Die Farbauswahl
           erkennt daran, dass der Meterpreis die Positionskennung setzt. Das Skript bindet sich nur an
           `.rc-dynamic-price`, nicht an dieses Feld. #}
        <input type="hidden"
               name="lineItems[{{ product.id }}][quantity]"
               value="1"
               data-dynamic-price="form">
    {% else %}
        {{ parent() }}

        {# Die eingegebene Länge wählt die Größenstufe.

           Nur ohne Meterpreis: Wo der Meterpreis greift, gibt es schon ein Längenfeld dieser
           Erweiterung, die Menge folgt dort der Länge, und der Mengenwähler fehlt. Beides zugleich hieße
           zwei Längenfelder und zwei Regeln für dieselbe Menge; der Artikel hier hat sein Feld aus
           `TmmsProductCustomerInputs` und wählt seine Größe über Varianten.

           Ein eigenes, leeres Element statt eines Kennzeichens an der Kaufbox, damit es ohne Einstellung
           gar nicht erst entsteht. Ob es entsteht, entscheidet `LengthSettingsSubscriber` über Produkt und
           Kategoriekette. Sein Wert ist die Kennung des Elternartikels, der Schlüssel des Zwischenlagers
           über den Variantenwechsel; die Kennung der Variante ist nach dem Sprung eine andere. #}
        {% set rcLength = page.extensions.rcLengthSettings|default(null) %}
        {% if rcLength and rcLength.lengthSwitch %}
            <div class="rc-length-variant-switch"
                 data-rc-length-variant-switch="{{ product.parentId ?: product.id }}"
                 data-rc-length-variant-switch-options='{{ {
                     titleAdjusted: 'rc-dynamic-price.lengthSwitch.modalTitleAdjusted'|trans,
                     titleHint: 'rc-dynamic-price.lengthSwitch.modalTitleHint'|trans,
                     textAdjusted: 'rc-dynamic-price.lengthSwitch.adjusted'|trans,
                     textOutOfRange: 'rc-dynamic-price.lengthSwitch.outOfRange'|trans,
                     textNextStep: 'rc-dynamic-price.lengthSwitch.nextStep'|trans,
                     textAskUnit: 'rc-dynamic-price.lengthSwitch.askUnit'|trans,
                     inputSelector: '.tmms-customer-input-value[name="tmms-customer-input-value-' ~ rcLength.lengthFieldNumber ~ '"]',
                     groupId: rcLength.lengthGroupId|default(''),
                     lengthOnly: rcLength.lengthOnly,
                     showStepHint: config('RcDynamicPrice.config.lengthSwitchStepHint') ? true : false
                 }|json_encode|e('html_attr') }}'
                 hidden></div>
        {% endif %}
    {% endif %}

    {# Geführte Auswahl: erst die Länge, dann nur die dazu kaufbaren Optionen.

       Die Angaben setzt `GuidedSelectionSubscriber` nur, wenn Haken, Längengruppe und kaufbare
       Kombinationen da sind. Das Skript blendet aus, was noch nicht dran ist; ohne Skript bleibt die
       Auswahl, wie der Kern sie baut. Den Hinweis auf den nächsten Schritt setzt das Skript hinter die
       Auswahl; hier stünde er im Kasten, der bis zur eindeutigen Variante verborgen ist. #}
    {% if page.extensions.rcGuidedSelection is defined %}
        {% set rcGuided = page.extensions.rcGuidedSelection %}
        <div class="rc-guided-selection"
             data-rc-guided-selection="{{ product.parentId ?: product.id }}"
             data-rc-guided-selection-options='{{ {
                 lengthGroupId: rcGuided.lengthGroupId,
                 groups: rcGuided.groups,
                 combinations: rcGuided.combinations,
                 textChooseFirst: 'rc-dynamic-price.guidedSelection.chooseFirst'|trans,
                 textChooseNext: 'rc-dynamic-price.guidedSelection.chooseNext'|trans,
                 textPlaceholder: 'rc-dynamic-price.guidedSelection.placeholder'|trans
             }|json_encode|e('html_attr') }}'
             hidden></div>
    {% endif %}
{% endblock %}
